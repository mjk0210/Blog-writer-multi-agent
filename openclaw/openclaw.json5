// OpenClaw config for the BlogGPT multi-agent pipeline.
// Copy (or merge) into ~/.openclaw/openclaw.json. See openclaw/README.md.
//
// Maps the CrewAI crew in server/app/main.py onto OpenClaw agents:
//   Content Planner -> blog-planner   (web_search via Gemini grounding, replaces Serper)
//   Content Writer  -> blog-writer    (no tools)
//   Editor          -> blog-editor    (no tools)
//   Banner Designer -> blog-designer  (image_generate; was DALL-E in crew.ipynb)
//   Crew (sequential process) -> blog-coordinator, which runs the steps via sessions_spawn.
{
  gateway: {
    port: 18789,
    bind: "loopback",
    // Token comes from OPENCLAW_GATEWAY_TOKEN in ~/.openclaw/.env.
    auth: { mode: "token" },
    http: {
      endpoints: {
        // Used by server/app (BLOG_BACKEND=openclaw) to call each agent directly.
        chatCompletions: { enabled: true },
      },
    },
  },

  tools: {
    web: { search: { provider: "gemini" } }, // reuses GEMINI_API_KEY
  },

  agents: {
    defaults: {
      model: { primary: "google/gemini-3.1-pro-preview" },
      imageGenerationModel: { primary: "google/gemini-3.1-flash-image-preview" },
      skipBootstrap: true, // workspaces are managed in this repo
      subagents: {
        maxSpawnDepth: 1, // coordinator -> specialists only; specialists never spawn
        maxConcurrent: 4,
        runTimeoutSeconds: 600,
        archiveAfterMinutes: 60,
      },
    },
    list: [
      {
        id: "blog-coordinator",
        default: true,
        workspace: "~/.openclaw/workspace-blog-coordinator",
        tools: {
          profile: "minimal",
          allow: ["sessions_spawn", "sessions_yield", "subagents", "agents_list", "read", "write"],
          deny: ["exec", "process", "browser", "web_search", "web_fetch"],
        },
        subagents: {
          allowAgents: ["blog-planner", "blog-writer", "blog-editor", "blog-designer"],
          requireAgentId: true,
          delegationMode: "prefer",
        },
        skills: ["blog-pipeline"],
      },
      {
        id: "blog-planner",
        workspace: "~/.openclaw/workspace-blog-planner",
        model: { primary: "google/gemini-3-flash-preview" },
        tools: { profile: "minimal", allow: ["web_search", "web_fetch"] },
        skills: [],
      },
      {
        id: "blog-writer",
        workspace: "~/.openclaw/workspace-blog-writer",
        tools: { profile: "minimal" },
        skills: [],
      },
      {
        id: "blog-editor",
        workspace: "~/.openclaw/workspace-blog-editor",
        tools: { profile: "minimal" },
        skills: [],
      },
      {
        id: "blog-designer",
        workspace: "~/.openclaw/workspace-blog-designer",
        model: { primary: "google/gemini-3-flash-preview" },
        tools: { profile: "minimal", allow: ["image_generate"] },
        skills: [],
      },
    ],
  },

  // Optional: chat with the coordinator from Telegram. Uncomment and set
  // TELEGRAM_BOT_TOKEN, or use any other channel (Slack, Discord, WhatsApp...).
  // bindings: [
  //   { agentId: "blog-coordinator", match: { channel: "telegram" } },
  // ],
}
