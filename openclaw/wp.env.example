# Copy to ~/.config/projectmetrics/wp.env and chmod 600 it.
WP_URL=https://projectmetrics.co.uk
WP_USER=Mike_bot
# Users -> Profile -> Application Passwords in WordPress (spaces are fine)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Optional
# Use rest_route if your host strips logins from /wp-json/ (auto detects this)
# WP_ROUTE_STYLE=rest_route
# WP_CATEGORIES=3,7
# WP_INCLUDE_NOTES=0
# WP_NOTIFY_TARGET=123456789
# WP_NOTIFY_ACCOUNT=blog
