# Copy to ~/.config/projectmetrics/cost.env and chmod 600 it.
# The OpenRouter key used ONLY by the blog agents (gives the actual cost per post).
OPENROUTER_BLOG_KEY=sk-or-v1-xxxxxxxx
# Telegram chat to send each post's cost to, and the bot account to send it from.
COST_NOTIFY_TARGET=123456789
COST_NOTIFY_ACCOUNT=blog
# Optional: also show pounds at a fixed rate.
# COST_GBP_PER_USD=0.79
